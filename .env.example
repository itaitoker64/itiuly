# מחרוזת החיבור של Neon (Vercel מגדיר את זה אוטומטית כשמחברים את הפרויקט ל-Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# מפתח לחתימת עוגיית ההתחברות — מחרוזת אקראית ארוכה. אל תשתפו אותה.
# ליצירה:  openssl rand -base64 32
AUTH_SECRET=

# הסיסמאות של שני המשתמשים
ITAI_PASSWORD=
TALIA_PASSWORD=
